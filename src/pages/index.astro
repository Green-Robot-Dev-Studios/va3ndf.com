---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import Icon from '../components/Icon.astro';
import me from '../assets/me.jpeg';
import { getAllEntries, partitionPinned } from '../lib/content';
import { SOCIAL_LINKS } from '../consts';

// The home page is the whole archive — writing and builds in one stream —
// so there is no "see all" anywhere to click. Anything with `pinned` in its
// frontmatter is lifted out into a selection above it.
const { pinned, rest } = partitionPinned(await getAllEntries());
---

<Base>
	<section class="intro">
		<div class="who">
			<Image class="avatar" src={me} alt="Nick Ficara" width={112} height={112} loading="eager" />
			<div>
				<h1>Nick Ficara</h1>
				<p class="meta callsign">
					VA3NDF <span class="sep">/</span> AS214681 <span class="sep">/</span> Ontario, CA
				</p>
			</div>
		</div>

		<p class="blurb">
			I write software, operate an amateur radio station, and run my own corner of the
			internet. Away from the keyboard I make things — laser cut, machined, soldered,
			and occasionally sewn. This is where both halves get written down.
		</p>

		<ul class="links">
			{
				SOCIAL_LINKS.map((link) => (
					<li>
						<a
							href={link.href}
							target={link.href.startsWith('http') ? '_blank' : undefined}
							rel="noopener"
						>
							<Icon name={link.icon} size={13} />
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</section>

	{
		pinned.length > 0 && (
			<section class="block">
				<h2 class="label heading">Selected</h2>
				<EntryList entries={pinned} showKind titleTag="h3" eagerCount={3} size="large" />
			</section>
		)
	}

	<section class="block">
		{
			pinned.length > 0 ? (
				<h2 class="label heading">Archive</h2>
			) : (
				<h2 class="sr-only">Everything, newest first</h2>
			)
		}
		<EntryList
			entries={rest}
			showKind
			groupByYear
			titleTag="h3"
			eagerCount={pinned.length > 0 ? 0 : 3}
		/>
	</section>

	<p class="puzzle meta">
		There is a <a href="/puzzle">puzzle</a> hidden on this site. Solve it and say hello.
	</p>
</Base>

<style>
	.intro {
		margin-bottom: 3rem;
	}

	.who {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.avatar {
		width: 56px;
		height: 56px;
		border-radius: 50%;
		border: 1px solid var(--line-strong);
		object-fit: cover;
		flex-shrink: 0;
	}

	h1 {
		font-size: 1.375rem;
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	.callsign {
		margin-top: 0.2rem;
		letter-spacing: 0.04em;
	}

	.callsign .sep {
		color: var(--line-strong);
	}

	.blurb {
		margin-top: 1.35rem;
		font-size: 1.0625rem;
		line-height: 1.6;
		color: var(--text-soft);
		max-width: 36rem;
		text-wrap: pretty;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1rem;
		list-style: none;
		padding: 0;
		margin-top: 1.25rem;
	}

	.links a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
		text-decoration: none;
		border-bottom: 1px solid transparent;
		padding-bottom: 1px;
	}

	.links a:hover {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}

	.heading {
		margin-bottom: 0.85rem;
	}

	.block + .block {
		margin-top: 2.75rem;
	}

	.puzzle {
		margin-top: 2rem;
	}

	.puzzle a {
		color: var(--accent);
	}
</style>
