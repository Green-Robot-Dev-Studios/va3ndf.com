---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getTagMap, type Entry } from '../../lib/content';

export async function getStaticPaths() {
	const map = await getTagMap();
	return [...map.entries()].map(([tag, { label, entries }]) => ({
		params: { tag },
		props: { label, entries },
	}));
}

interface Props {
	label: string;
	entries: Entry[];
}

const { label, entries } = Astro.props;
---

<Base
	title={`Tagged “${label}”`}
	description={`Everything on va3ndf.com tagged ${label}.`}
>
	<header class="page-head">
		<p class="label">Tagged</p>
		<h1>{label}</h1>
		<p class="sub">{entries.length} {entries.length === 1 ? 'entry' : 'entries'} · <a href="/tags">all tags</a></p>
	</header>

	<EntryList entries={entries} showKind titleTag="h2" />
</Base>

<style>
	.page-head {
		margin-bottom: 2rem;
	}

	h1 {
		font-family: var(--font-serif);
		font-size: 2rem;
		letter-spacing: -0.02em;
		margin-top: 0.3rem;
	}

	.sub {
		margin-top: 0.4rem;
		color: var(--text-muted);
		font-size: 0.9375rem;
	}

	.sub a {
		color: inherit;
	}

	.sub a:hover {
		color: var(--accent);
	}
</style>
