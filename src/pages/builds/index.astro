---
import Base from '../../layouts/Base.astro';
import BuildGrid from '../../components/BuildGrid.astro';
import { getEntries } from '../../lib/content';

const builds = await getEntries('builds');
const shareImage = builds.find((build) => build.data.heroImage)?.data.heroImage;
---

<Base
	title="Builds"
	description="Things I've made. Laser cut, machined, soldered, anodized, and stitched."
	image={shareImage}
	wide
>
	<header class="page-head">
		<h1>Builds</h1>
		<p class="sub">
			Physical things. Laser cut, machined, soldered, anodized, stitched.
			{builds.length} of them.
		</p>
	</header>

	<BuildGrid entries={builds} titleTag="h2" />
</Base>

<style>
	.page-head {
		margin-bottom: 2.25rem;
	}

	h1 {
		font-family: var(--font-serif);
		font-size: 2rem;
		letter-spacing: -0.02em;
	}

	.sub {
		margin-top: 0.4rem;
		color: var(--text-muted);
		font-size: 0.9375rem;
	}
</style>
