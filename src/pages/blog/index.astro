---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getEntries } from '../../lib/content';

const posts = await getEntries('blog');
---

<Base
	title="Writing"
	description="Posts on software, amateur radio, homelabbing, networks, and whatever else Nick Ficara (VA3NDF) has been taking apart."
>
	<header class="page-head">
		<h1>Writing</h1>
		<p class="sub">
			Software, radio, networks, and the occasional detour. {posts.length} posts.
		</p>
	</header>

	<EntryList entries={posts} groupByYear titleTag="h2" />
</Base>

<style>
	.page-head {
		margin-bottom: 2rem;
	}

	h1 {
		font-family: var(--font-serif);
		font-size: 2rem;
		letter-spacing: -0.02em;
	}

	.sub {
		margin-top: 0.4rem;
		color: var(--text-muted);
		font-size: 0.9375rem;
	}
</style>
