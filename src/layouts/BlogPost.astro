---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Icon from '../components/Icon.astro';
import { cleanDescription, readingTime, slugifyTag, type Entry } from '../lib/content';

interface Props {
	entry: Entry;
	prev?: Entry;
	next?: Entry;
}

const { entry, prev, next } = Astro.props;
const { title, date, updatedDate, heroImage, tags = [] } = entry.data;

const description = cleanDescription(entry);
const backHref = entry.kind === 'builds' ? '/builds' : '/blog';
const backLabel = entry.kind === 'builds' ? 'builds' : 'writing';
const minutes = readingTime(entry.body);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description || `${title} — VA3NDF`}
			image={heroImage}
			type="article"
			publishedTime={date}
		/>
	</head>
	<body>
		<Header />

		<main>
			<article>
				<div class="column">
					<a class="back meta" href={backHref}>
						<Icon name="arrow" size={12} class="flip" />
						{backLabel}
					</a>

					<header class="head">
						<p class="meta kicker">
							{date && <FormattedDate date={date} format="long" />}
							{entry.kind === 'blog' && <><span class="sep">/</span>{minutes} min read</>}
							{
								updatedDate && (
									<>
										<span class="sep">/</span>updated <FormattedDate date={updatedDate} />
									</>
								)
							}
						</p>

						<h1>{title}</h1>

						{description && <p class="lede">{description}</p>}
					</header>
				</div>

				{
					heroImage && (
						<div class="wrap hero-band">
							<figure class="hero">
								<Image
									src={heroImage}
									width={1440}
									widths={[640, 1024, 1440]}
									sizes="(max-width: 48rem) 100vw, 43rem"
									alt=""
									loading="eager"
									fetchpriority="high"
								/>
							</figure>
						</div>
					)
				}

				<div class="prose column">
					<slot />
				</div>

				{
					tags.length > 0 && (
						<div class="column tags">
							{tags.map((tag) => (
								<a class="tag" href={`/tags/${slugifyTag(tag)}/`}>
									{tag}
								</a>
							))}
						</div>
					)
				}
			</article>

			{
				(prev || next) && (
					<nav class="column pager" aria-label="More posts">
						{prev ? (
							<a class="pager-link" href={prev.href}>
								<span class="label">Previous</span>
								<span class="pager-title">{prev.data.title}</span>
							</a>
						) : (
							<span />
						)}
						{next && (
							<a class="pager-link right" href={next.href}>
								<span class="label">Next</span>
								<span class="pager-title">{next.data.title}</span>
							</a>
						)}
					</nav>
				)
			}
		</main>

		<Footer />

		<style>
			/* The reading column is narrower than the hero/header band. */
			.column {
				width: 100%;
				max-width: var(--measure);
				margin-inline: auto;
				padding-inline: 1.5rem;
			}

			@media (max-width: 34rem) {
				.column {
					padding-inline: 1.15rem;
				}
			}

			.back {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				text-decoration: none;
				margin-bottom: 2rem;
			}

			.back:hover {
				color: var(--accent);
			}

			.back :global(.flip) {
				transform: rotate(180deg);
				transition: transform 0.2s ease;
			}

			.back:hover :global(.flip) {
				transform: rotate(180deg) translateX(2px);
			}

			.head {
				margin-bottom: 2rem;
			}

			.kicker {
				display: flex;
				align-items: center;
				gap: 0.45rem;
				flex-wrap: wrap;
				margin-bottom: 0.75rem;
			}

			.sep {
				color: var(--line-strong);
			}

			h1 {
				font-family: var(--font-serif);
				font-size: clamp(1.85rem, 1.2rem + 2.4vw, 2.6rem);
				font-weight: 600;
				line-height: 1.12;
				letter-spacing: -0.02em;
			}

			.lede {
				margin-top: 0.85rem;
				font-size: 1.0625rem;
				line-height: 1.55;
				color: var(--text-muted);
				max-width: 34rem;
				text-wrap: pretty;
			}

			.hero {
				margin: 0 0 3rem;
			}

			/* Cap the height so portrait or product shots don't become a wall
			   of empty background before the first paragraph. */
			.hero :global(img) {
				max-width: 100%;
				max-height: 26rem;
				width: auto;
				margin-inline: auto;
				border-radius: var(--radius-lg);
				border: 1px solid var(--line);
				background: var(--bg-sunken);
			}

			.tags {
				margin-top: 3rem;
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
			}

			.tag {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--text-muted);
				text-decoration: none;
				border: 1px solid var(--line);
				border-radius: 999px;
				padding: 0.15rem 0.6rem;
				transition: all 0.15s ease;
			}

			.tag:hover {
				color: var(--accent);
				border-color: var(--accent);
				background: var(--accent-soft);
			}

			.pager {
				margin-top: 4rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--line);
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.5rem;
			}

			.pager-link {
				text-decoration: none;
				display: block;
				min-width: 0;
			}

			.pager-link.right {
				text-align: right;
			}

			.pager-title {
				display: block;
				margin-top: 0.25rem;
				font-size: 0.9375rem;
				font-weight: 500;
				color: var(--text-soft);
				line-height: 1.35;
			}

			.pager-link:hover .pager-title {
				color: var(--accent);
			}
		</style>
	</body>
</html>
