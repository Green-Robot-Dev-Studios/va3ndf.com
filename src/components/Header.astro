---
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import { NAV_LINKS } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header>
	<div class="wrap bar">
		<a class="mark" href="/" aria-label="Home">
			va<span>3</span>ndf
		</a>

		<nav aria-label="Main">
			{
				NAV_LINKS.map((link) => (
					<a href={link.href} class:list={['nav-link', { active: isActive(link.href) }]}>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="tools">
			<a class="icon-link" href="/rss.xml" aria-label="RSS feed" title="RSS feed">
				<Icon name="rss" size={14} />
			</a>
			<ThemeToggle />
		</div>
	</div>
</header>

<style>
	header {
		border-bottom: 1px solid var(--line);
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: saturate(150%) blur(8px);
		position: sticky;
		top: 0;
		z-index: 10;
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		height: 3.25rem;
	}

	.mark {
		font-family: var(--font-mono);
		font-size: 0.9375rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-decoration: none;
		color: var(--text);
		margin-right: auto;
	}

	.mark span {
		color: var(--accent);
	}

	nav {
		display: flex;
		gap: 1.1rem;
	}

	.nav-link {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--text-muted);
		text-decoration: none;
		padding-block: 0.25rem;
		border-bottom: 1px solid transparent;
		transition: color 0.15s ease;
	}

	.nav-link:hover {
		color: var(--text);
	}

	.nav-link.active {
		color: var(--text);
		border-bottom-color: var(--accent);
	}

	.tools {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		margin-left: 0.25rem;
	}

	.icon-link {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: var(--radius);
		color: var(--text-muted);
		border: 1px solid transparent;
	}

	.icon-link:hover {
		color: var(--accent);
		border-color: var(--line);
		background: var(--bg-raised);
	}

	@media (max-width: 30rem) {
		.bar {
			gap: 0.85rem;
		}
		nav {
			gap: 0.8rem;
		}
		.icon-link {
			display: none;
		}
	}
</style>
