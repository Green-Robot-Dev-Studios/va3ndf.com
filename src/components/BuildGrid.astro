---
import BuildCard from './BuildCard.astro';
import type { Entry } from '../lib/content';

interface Props {
	entries: Entry[];
	eagerCount?: number;
	titleTag?: 'h2' | 'h3';
}

const { entries, eagerCount = 3, titleTag = 'h3' } = Astro.props;
---

<ul class="grid">
	{entries.map((entry, i) => <BuildCard entry={entry} eager={i < eagerCount} titleTag={titleTag} />)}
</ul>

<style>
	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
		gap: 1.75rem 1.25rem;
	}

	@media (max-width: 34rem) {
		.grid {
			grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
			gap: 1.5rem 1rem;
		}
	}
</style>
