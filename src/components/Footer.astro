---
import Icon from './Icon.astro';
import { SOCIAL_LINKS, SITE_AUTHOR } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<div class="wrap inner">
		<div class="left">
			<p class="meta">
				&copy; {year} {SITE_AUTHOR} · <span class="call">VA3NDF</span> · <a href="/puzzle"
					>puzzle</a
				>
			</p>
			<p class="meta faint">Built with Astro. No trackers, no cookies.</p>
		</div>

		<ul class="socials">
			{
				SOCIAL_LINKS.map((link) => (
					<li>
						<a
							href={link.href}
							title={link.label}
							rel={link.href.startsWith('http') ? 'me noopener' : undefined}
							target={link.href.startsWith('http') ? '_blank' : undefined}
						>
							<span class="sr-only">{link.label}</span>
							<Icon name={link.icon} size={16} />
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--line);
		padding-block: 1.75rem 2.5rem;
		margin-top: auto;
	}

	.inner {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.left p + p {
		margin-top: 0.3rem;
	}

	.faint {
		color: color-mix(in srgb, var(--text-muted) 70%, transparent);
	}

	.call {
		color: var(--accent);
		letter-spacing: 0.06em;
	}

	.meta a {
		color: inherit;
		text-decoration-color: var(--line-strong);
	}

	.meta a:hover {
		color: var(--accent);
	}

	.socials {
		display: flex;
		gap: 0.15rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.socials a {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: var(--radius);
		color: var(--text-muted);
		border: 1px solid transparent;
	}

	.socials a:hover {
		color: var(--accent);
		border-color: var(--line);
		background: var(--bg-raised);
	}
</style>
